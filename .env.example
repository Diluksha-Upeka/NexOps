# === Application ===
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# === Database ===
# Used by the application to connect to PostgreSQL
DATABASE_URL=postgresql+psycopg://incident_app:change-me@localhost:5432/incident_lab

# Used by Docker Compose to configure the PostgreSQL container
POSTGRES_USER=incident_app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=incident_lab

# === LLM Provider ===
# Set to "fake" for deterministic no-key mode, or "openai"/"google" for an
# OpenAI-compatible hosted endpoint. Google Gemini uses:
# https://generativelanguage.googleapis.com/v1beta/openai
LLM_PROVIDER=fake
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=60

# === Graph Configuration ===
GRAPH_MAX_ROUNDS=2
GRAPH_TIMEOUT_SECONDS=90
TOOL_TIMEOUT_SECONDS=10

# === Simulator ===
SIMULATOR_ENABLED=true
SIMULATOR_MAX_FAULT_SECONDS=300

# === Frontend ===
FRONTEND_ORIGIN=http://localhost:5173

# === Observability (optional, later phases) ===
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# === Logging ===
LOG_LEVEL=INFO
